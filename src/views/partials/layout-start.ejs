<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <title><%= title %> | <%= appName %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    :root {
      color-scheme: light;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: 'Prompt', 'Kanit', 'Segoe UI', Tahoma, sans-serif;
      background-color: #f3f4f6;
      color: #1f2937;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .topbar {
      background: linear-gradient(135deg, #1d4ed8, #2563eb);
      color: #fff;
      padding: 1.25rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      flex-wrap: wrap;
      box-shadow: 0 10px 30px rgba(29, 78, 216, 0.25);
    }

    .topbar__brand {
      font-weight: 700;
      font-size: 1.35rem;
      letter-spacing: 0.03em;
    }

    .topbar__nav {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .topbar__link {
      font-weight: 500;
      padding: 0.45rem 0.9rem;
      border-radius: 999px;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .topbar__link:hover,
    .topbar__link:focus-visible {
      background-color: rgba(255, 255, 255, 0.18);
    }

    .container {
      width: min(1100px, 94vw);
      margin: 2.5rem auto;
      flex: 1;
    }

    .card {
      background-color: #fff;
      border-radius: 18px;
      padding: 1.75rem;
      margin-bottom: 1.75rem;
      box-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
      flex-wrap: wrap;
      margin-bottom: 1.25rem;
    }

    .card-header h2 {
      margin: 0;
      font-size: 1.35rem;
      font-weight: 700;
      color: #111827;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.55rem 1.2rem;
      border-radius: 999px;
      border: none;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.95rem;
      transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.2s ease, color 0.2s ease;
      text-decoration: none;
      gap: 0.35rem;
    }

    .btn:hover,
    .btn:focus-visible {
      transform: translateY(-1px);
      box-shadow: 0 10px 18px rgba(15, 23, 42, 0.15);
    }

    .btn:focus-visible {
      outline: 2px solid rgba(37, 99, 235, 0.4);
      outline-offset: 2px;
    }

    .btn-primary {
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      color: #fff;
    }

    .btn-secondary {
      background-color: #e0e7ff;
      color: #1d4ed8;
    }

    .btn-ghost {
      background-color: transparent;
      border: 1px solid rgba(37, 99, 235, 0.45);
      color: #1d4ed8;
      box-shadow: none;
    }

    .btn-ghost:hover,
    .btn-ghost:focus-visible {
      background-color: rgba(37, 99, 235, 0.08);
    }

    .btn-danger {
      background: linear-gradient(135deg, #ef4444, #dc2626);
      color: #fff;
    }

    .btn-small {
      padding: 0.4rem 0.85rem;
      font-size: 0.85rem;
    }

    .btn-group {
      display: inline-flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .inline-form {
      display: inline;
    }

    .alert {
      padding: 0.85rem 1.2rem;
      border-radius: 12px;
      margin-bottom: 1.25rem;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .alert--success {
      background-color: #ecfdf5;
      color: #065f46;
      border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .alert--danger {
      background-color: #fef2f2;
      color: #b91c1c;
      border: 1px solid rgba(248, 113, 113, 0.35);
    }

    .filters-form {
      display: grid;
      gap: 1.25rem;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      align-items: end;
    }

    .filters-form .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }

    label {
      font-weight: 600;
      color: #1f2937;
      font-size: 0.95rem;
    }

    input[type='text'],
    input[type='email'],
    input[type='password'],
    select {
      padding: 0.65rem 0.85rem;
      border-radius: 10px;
      border: 1px solid #d1d5db;
      font-size: 0.95rem;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    input:focus,
    select:focus {
      outline: none;
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.18);
    }

    .filters-actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .table-wrapper {
      overflow-x: auto;
      border-radius: 14px;
      box-shadow: inset 0 0 0 1px rgba(226, 232, 240, 0.6);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 780px;
    }

    th, td {
      padding: 0.85rem 1rem;
      text-align: left;
      font-size: 0.95rem;
      border-bottom: 1px solid #e5e7eb;
    }

    th {
      background-color: #f8fafc;
      font-weight: 700;
      color: #0f172a;
      position: sticky;
      top: 0;
      z-index: 1;
    }

    tbody tr:hover {
      background-color: #f9fafb;
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    .text-muted {
      color: #6b7280;
      font-size: 0.88rem;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      padding: 0.25rem 0.7rem;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .badge--not_started {
      background-color: #e2e8f0;
      color: #1e293b;
    }

    .badge--in_progress {
      background-color: #fef3c7;
      color: #92400e;
    }

    .badge--passed {
      background-color: #dcfce7;
      color: #166534;
    }

    .badge--failed {
      background-color: #fee2e2;
      color: #991b1b;
    }

    .pagination {
      margin-top: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .pagination-info {
      font-size: 0.9rem;
      color: #4b5563;
    }

    .pagination-controls {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .pagination-page {
      font-weight: 600;
      color: #1f2937;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .form-grid .form-field {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .field-error {
      color: #b91c1c;
      font-size: 0.85rem;
    }

    .form-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.85rem;
      flex-wrap: wrap;
      margin-top: 1.25rem;
    }

    .footer {
      margin-top: auto;
      padding: 1.5rem;
      text-align: center;
      font-size: 0.85rem;
      color: #6b7280;
    }

    .empty-state {
      padding: 2.5rem 1rem;
      text-align: center;
      color: #6b7280;
    }

    @media (max-width: 640px) {
      .topbar {
        padding: 1.1rem 1.25rem;
      }

      .card {
        padding: 1.25rem;
      }

      table {
        min-width: 640px;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .filters-form {
        grid-template-columns: 1fr;
      }

      .filters-actions {
        justify-content: flex-start;
      }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar__brand"><%= appName %></div>
    <% if (typeof buildAdminUrl === 'function') { %>
      <nav class="topbar__nav">
        <a class="topbar__link" href="<%= buildAdminUrl('') %>">รายการผู้เรียน</a>
        <a class="topbar__link" href="<%= buildAdminUrl('new') %>">เพิ่มผู้เรียน</a>
        <a class="topbar__link" href="<%= buildAdminUrl('import') %>">นำเข้า CSV</a>
      </nav>
    <% } %>
  </header>
  <main class="container">
    <%- include('partials/messages', { notice: typeof notice !== 'undefined' ? notice : null, error: typeof error !== 'undefined' ? error : null }) %>
